<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <RootNamespace>SoftPlc.AgvSimulator</RootNamespace>
    <AssemblyName>SoftPlc.AgvSimulator</AssemblyName>
  </PropertyGroup>

  <!-- Avalonia UI -->
  <ItemGroup>
    <PackageReference Include="Avalonia"                  Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop"          Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent"    Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter"      Version="11.2.3" />
    <PackageReference Include="Avalonia.ReactiveUI"       Version="11.2.3" />
    <PackageReference Include="Serilog"                   Version="4.3.1"  />
    <PackageReference Include="Serilog.Sinks.Console"     Version="6.1.1"  />
    <PackageReference Include="Serilog.Sinks.File"        Version="7.0.0"  />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

  <!-- ASP.NET Core (for embedded REST API) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- SoftPlc projects -->
  <ItemGroup>
    <ProjectReference Include="..\SoftPlc.Core\SoftPlc.Core.csproj" />
    <ProjectReference Include="..\SoftPlc.S7Server\SoftPlc.S7Server.csproj" />
    <ProjectReference Include="..\SoftPlc.ControlApi\SoftPlc.ControlApi.csproj" />
  </ItemGroup>

</Project>

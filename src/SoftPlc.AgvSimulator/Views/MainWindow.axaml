<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SoftPlc.AgvSimulator.ViewModels"
        x:Class="SoftPlc.AgvSimulator.Views.MainWindow"
        Title="AGV Simulator - DB172"
        Width="1140" Height="800"
        MinWidth="960" MinHeight="640"
        Background="#f5f6f8">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#e0e2e8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8490a5"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#2c3345"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="165"/>
        </Style>
        <Style Selector="Border.offsetBadge">
            <Setter Property="Background" Value="#f0f1f4"/>
            <Setter Property="BorderBrush" Value="#dcdee5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="72"/>
        </Style>
        <Style Selector="TextBlock.offset">
            <Setter Property="Foreground" Value="#8a90a0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Consolas,Monospace"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="#98a0b0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="ToggleButton.signal">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="ToggleButton.signal:checked">
            <Setter Property="Background" Value="#2e8b57"/>
            <Setter Property="Foreground" Value="#ffffff"/>
        </Style>
        <Style Selector="ToggleButton.signal:unchecked">
            <Setter Property="Background" Value="#e4e6ec"/>
            <Setter Property="Foreground" Value="#6b7280"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Separator.row">
            <Setter Property="Background" Value="#eef0f4"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#e0e2e8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>
        <Style Selector="TextBlock.pillLabel">
            <Setter Property="Foreground" Value="#98a0b0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.pillValue">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#ffffff" Padding="12,5"
                BorderBrush="#e0e2e8" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="3">
                <Border Classes="pill">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Classes="pillLabel" Text="CPU"/>
                        <TextBlock x:Name="TbCpuState" Classes="pillValue"
                                   Text="{Binding CpuState}" Foreground="#2e8b57"/>
                    </StackPanel>
                </Border>
                <Border Classes="pill">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="pillLabel" Text="CYCLE"/>
                        <TextBlock Classes="pillValue" Text="{Binding ScanCycle}" Foreground="#4a5568"/>
                    </StackPanel>
                </Border>
                <Border Classes="pill">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="pillLabel" Text="SCAN"/>
                        <TextBlock Classes="pillValue" Foreground="#4a5568"
                                   Text="{Binding LastScanUs, StringFormat='{}{0} us'}"/>
                    </StackPanel>
                </Border>
                <Border Classes="pill">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="pillLabel" Text="OVERRUNS"/>
                        <TextBlock Classes="pillValue" Text="{Binding OverrunCount}" Foreground="#c05020"/>
                    </StackPanel>
                </Border>
                <Border Classes="pill">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="pillLabel" Text="S7"/>
                        <TextBlock Classes="pillValue" Text="{Binding S7Status}" Foreground="#2874a6"/>
                    </StackPanel>
                </Border>
                <Border Classes="pill">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="pillLabel" Text="API"/>
                        <TextBlock Classes="pillValue" Text="localhost:15000" Foreground="#5b6abf"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#ffffff" Padding="18,10"
                BorderBrush="#e0e2e8" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="AGV Simulator" FontSize="15" FontWeight="Bold"
                               Foreground="#2c3345" VerticalAlignment="Center"/>
                    <Border Background="#f0f1f4" CornerRadius="3" Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="DB172" FontSize="10" Foreground="#6b7280"
                                   FontFamily="Consolas,Monospace" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="SoftPLC S7-Compatible"
                           FontSize="11" Foreground="#b0b8c8" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Margin="10,8,10,4" Background="Transparent">

            <!-- TAB 1 - INPUTS -->
            <TabItem Header="  INPUT">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="2,6">
                    <StackPanel Margin="4,0" Spacing="0">

                        <Border Classes="card">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="cardTitle" Text="POWER &amp; CONTROL"/>
                                <Grid ColumnDefinitions="165,80,80,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="ON/OFF"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="0.0"/>
                                    </Border>
                                    <ToggleButton Grid.Column="2" Classes="signal"
                                                 IsChecked="{Binding OnOff, Mode=TwoWay}"
                                                 Content="{Binding OnOff, StringFormat='{}{0}'}"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Nut bat/tat AGV"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,80,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="START"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="0.1"/>
                                    </Border>
                                    <ToggleButton Grid.Column="2" Classes="signal"
                                                 IsChecked="{Binding Start, Mode=TwoWay}"
                                                 Content="{Binding Start, StringFormat='{}{0}'}"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Nut khoi dong AGV"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,80,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="CLEAR ERROR"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="0.2"/>
                                    </Border>
                                    <ToggleButton Grid.Column="2" Classes="signal"
                                                 IsChecked="{Binding ClearError, Mode=TwoWay}"
                                                 Content="{Binding ClearError, StringFormat='{}{0}'}"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Xoa loi cung"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,80,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="SAFETY RELAY"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="0.3"/>
                                    </Border>
                                    <ToggleButton Grid.Column="2" Classes="signal"
                                                 IsChecked="{Binding SafetyRelay, Mode=TwoWay}"
                                                 Content="{Binding SafetyRelay, StringFormat='{}{0}'}"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Trang thai EMG relay"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="cardTitle" Text="POWER READINGS"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="VOLTAGE (V)"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B2-5"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding ValueVoltage, Mode=TwoWay}"
                                                  Minimum="0" Maximum="100" Increment="0.1"
                                                  FormatString="F2"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="float  Dien ap pin"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="CURRENT (A)"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B6-9"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding ValueCurrent, Mode=TwoWay}"
                                                  Minimum="-50" Maximum="50" Increment="0.1"
                                                  FormatString="F2"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="float  Dong sac"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="cardTitle" Text="SAFETY"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="SIGNAL EMGS"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B10-11"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding SignalEmgs, Mode=TwoWay}"
                                                  Minimum="-32768" Maximum="32767"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="int16 bit  Cac nut EMG"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="SIGNAL BUMPER"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B12-13"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding SignalBumper, Mode=TwoWay}"
                                                  Minimum="-32768" Maximum="32767"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="int16 bit  Cac bumper"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="STATUS SENSOR"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B14-15"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding StatusSensor, Mode=TwoWay}"
                                                  Minimum="-32768" Maximum="32767"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="int16 bit  Cam bien on/off"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="SAFETY ZONE 1"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B16-17"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding SafetyZone1, Mode=TwoWay}"
                                                  Minimum="-32768" Maximum="32767"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="int16 bit  Vung an toan 1"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="SAFETY ZONE 2"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B18-19"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding SafetyZone2, Mode=TwoWay}"
                                                  Minimum="-32768" Maximum="32767"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="int16 bit  Vung an toan 2"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="cardTitle" Text="RFID"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="STATUS RFID"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B20-21"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding StatusRfid, Mode=TwoWay}"
                                                  Minimum="-1" Maximum="1"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="-1=loi  0=ngoai vung  1=trong vung"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="CODE RFID"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B22-23"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding CodeRfid, Mode=TwoWay}"
                                                  Minimum="0" Maximum="32767"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Ma the RFID hien tai"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="cardTitle" Text="MAGLINE"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="STATUS MAGLINE"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B24-25"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding StatusMagline, Mode=TwoWay}"
                                                  Minimum="-1" Maximum="1"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="-1=loi  1=binh thuong"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="VALUE MAGLINE"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B26-27"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding ValueMagline, Mode=TwoWay}"
                                                  Minimum="-32768" Maximum="32767"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="int16 bit  Mang bit line tu"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="cardTitle" Text="MOTOR 1  (LEFT)"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="STATUS"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B28-29"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding StatusMotor1, Mode=TwoWay}"
                                                  Minimum="-1" Maximum="1"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="-1=disconnected  1=normal"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="WARNING"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B30-31"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding WarnMotor1, Mode=TwoWay}"
                                                  Minimum="0" Maximum="32767"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Warning code"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="ERROR"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B32-33"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding ErrorMotor1, Mode=TwoWay}"
                                                  Minimum="0" Maximum="32767"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Error code"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="SPEED (rpm)"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B34-35"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding Speed1, Mode=TwoWay}"
                                                  Minimum="-5000" Maximum="5000"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Current speed"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="ENCODER"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B36-39"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding ValueEncoder1, Mode=TwoWay}"
                                                  Minimum="-2147483648" Maximum="2147483647"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="int32  Encoder value"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="cardTitle" Text="MOTOR 2  (RIGHT)"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="STATUS"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B40-41"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding StatusMotor2, Mode=TwoWay}"
                                                  Minimum="-1" Maximum="1"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="-1=disconnected  1=normal"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="WARNING"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B42-43"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding WarnMotor2, Mode=TwoWay}"
                                                  Minimum="0" Maximum="32767"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Warning code"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="ERROR"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B44-45"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding ErrorMotor2, Mode=TwoWay}"
                                                  Minimum="0" Maximum="32767"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Error code"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="SPEED (rpm)"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B46-47"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding Speed2, Mode=TwoWay}"
                                                  Minimum="-5000" Maximum="5000"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Current speed"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="ENCODER"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B48-51"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding ValueEncoder2, Mode=TwoWay}"
                                                  Minimum="-2147483648" Maximum="2147483647"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="int32  Encoder value"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="cardTitle" Text="MOTION FEEDBACK"/>
                                <Grid ColumnDefinitions="165,80,225,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="MOVE MODE (in)"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B52-53"/>
                                    </Border>
                                    <ComboBox Grid.Column="2"
                                              SelectedIndex="{Binding MoveMoveIn, Mode=TwoWay}">
                                        <ComboBoxItem Content="0 - Dung"/>
                                        <ComboBoxItem Content="1 - Tien theo line"/>
                                        <ComboBoxItem Content="2 - Lui theo line"/>
                                        <ComboBoxItem Content="3 - Xoay trai 90"/>
                                        <ComboBoxItem Content="4 - Xoay phai 90"/>
                                        <ComboBoxItem Content="5 - Xoay 180"/>
                                        <ComboBoxItem Content="6 - Tien dung vach ngang"/>
                                        <ComboBoxItem Content="7 - Lui dung vach ngang"/>
                                        <ComboBoxItem Content="8 - Tien dung the"/>
                                        <ComboBoxItem Content="9 - Lui dung the"/>
                                        <ComboBoxItem Content="10 - Tien tu do"/>
                                        <ComboBoxItem Content="11 - Lui tu do"/>
                                        <ComboBoxItem Content="12 - Xoay trai tu do"/>
                                        <ComboBoxItem Content="13 - Xoay phai tu do"/>
                                    </ComboBox>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Mode dang chap hanh"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="STATUS MOVE"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B54-55"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding StatusMove, Mode=TwoWay}"
                                                  Minimum="0" Maximum="32767"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Trang thai di chuyen"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,225,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="LIFT MODE (in)"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B56-57"/>
                                    </Border>
                                    <ComboBox Grid.Column="2"
                                              SelectedIndex="{Binding ModeLiftIn, Mode=TwoWay}">
                                        <ComboBoxItem Content="0 - Dung/Reset"/>
                                        <ComboBoxItem Content="1 - Nang"/>
                                        <ComboBoxItem Content="2 - Ha"/>
                                    </ComboBox>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Mode ban nang dang chap hanh"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,225,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="STATUS LIFT"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B58-59"/>
                                    </Border>
                                    <ComboBox Grid.Column="2"
                                              SelectedIndex="{Binding StatusLift, Mode=TwoWay}">
                                        <ComboBoxItem Content="0 - Dung/Reset"/>
                                        <ComboBoxItem Content="1 - Dang thuc hien"/>
                                        <ComboBoxItem Content="2 - Loi time out"/>
                                        <ComboBoxItem Content="3 - Loi khac (3)"/>
                                        <ComboBoxItem Content="4 - Loi khac (4)"/>
                                        <ComboBoxItem Content="5 - Hoan thanh nang"/>
                                        <ComboBoxItem Content="6 - Hoan thanh ha"/>
                                    </ComboBox>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Trang thai thuc hien"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2 - OUTPUTS -->
            <TabItem Header="OUTPUT">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="2,6">
                    <StackPanel Margin="4,0" Spacing="0">

                        <Border Classes="card">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="cardTitle" Text="CONTROL FLAGS"/>
                                <Grid ColumnDefinitions="165,80,80,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="WRITE EMG"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="60.0"/>
                                    </Border>
                                    <ToggleButton Grid.Column="2" Classes="signal"
                                                 IsChecked="{Binding WriteEmg, Mode=TwoWay}"
                                                 Content="{Binding WriteEmg, StringFormat='{}{0}'}"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Kich hoat EMG"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,80,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="RESET"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="60.1"/>
                                    </Border>
                                    <ToggleButton Grid.Column="2" Classes="signal"
                                                 IsChecked="{Binding Reset, Mode=TwoWay}"
                                                 Content="{Binding Reset, StringFormat='{}{0}'}"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Reset EMG"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,80,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="CHARGE"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="60.2"/>
                                    </Border>
                                    <ToggleButton Grid.Column="2" Classes="signal"
                                                 IsChecked="{Binding Charge, Mode=TwoWay}"
                                                 Content="{Binding Charge, StringFormat='{}{0}'}"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Bat/tat sac"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,80,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="BRAKE"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="60.3"/>
                                    </Border>
                                    <ToggleButton Grid.Column="2" Classes="signal"
                                                 IsChecked="{Binding Brake, Mode=TwoWay}"
                                                 Content="{Binding Brake, StringFormat='{}{0}'}"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Bat/tat phanh"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="cardTitle" Text="PERIPHERALS"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="SOUND"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B62-63"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding Sound, Mode=TwoWay}"
                                                  Minimum="0" Maximum="10"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="0=off  1-10=mode"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="LIGHT"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B64-65"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding Light, Mode=TwoWay}"
                                                  Minimum="0" Maximum="10"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="0=off  1-10=mode LED"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="FIELD SET 1"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B66-67"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding FieldSet1, Mode=TwoWay}"
                                                  Minimum="0" Maximum="10"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="0=off  1-10=SICK zone"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="FIELD SET 2"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B68-69"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding FieldSet2, Mode=TwoWay}"
                                                  Minimum="0" Maximum="10"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="0=off  1-10=SICK zone"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="cardTitle" Text="MOTION COMMANDS"/>
                                <Grid ColumnDefinitions="165,80,225,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="CONTROL MOTION"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B70-71"/>
                                    </Border>
                                    <ComboBox Grid.Column="2"
                                              SelectedIndex="{Binding ControlMotion, Mode=TwoWay}">
                                        <ComboBoxItem Content="0 - Khong dieu khien"/>
                                        <ComboBoxItem Content="1 - Mode cu the"/>
                                        <ComboBoxItem Content="2 - Van toc tu PC"/>
                                    </ComboBox>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Che do dieu khien"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="SPEED MOTOR 1"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B72-73"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding SpeedMotor1, Mode=TwoWay}"
                                                  Minimum="-5000" Maximum="5000"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Left wheel"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="SPEED MOTOR 2"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B74-75"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding SpeedMotor2, Mode=TwoWay}"
                                                  Minimum="-5000" Maximum="5000"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Right wheel"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,225,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="MOVE MODE (out)"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B76-77"/>
                                    </Border>
                                    <ComboBox Grid.Column="2"
                                              SelectedIndex="{Binding MoveMoveOut, Mode=TwoWay}">
                                        <ComboBoxItem Content="0 - Dung"/>
                                        <ComboBoxItem Content="1 - Tien theo line"/>
                                        <ComboBoxItem Content="2 - Lui theo line"/>
                                        <ComboBoxItem Content="3 - Xoay trai 90"/>
                                        <ComboBoxItem Content="4 - Xoay phai 90"/>
                                        <ComboBoxItem Content="5 - Xoay 180"/>
                                        <ComboBoxItem Content="6 - Tien dung vach ngang"/>
                                        <ComboBoxItem Content="7 - Lui dung vach ngang"/>
                                        <ComboBoxItem Content="8 - Tien dung the"/>
                                        <ComboBoxItem Content="9 - Lui dung the"/>
                                        <ComboBoxItem Content="10 - Tien tu do"/>
                                        <ComboBoxItem Content="11 - Lui tu do"/>
                                        <ComboBoxItem Content="12 - Xoay trai tu do"/>
                                        <ComboBoxItem Content="13 - Xoay phai tu do"/>
                                    </ComboBox>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Mode di chuyen yeu cau"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="SPEED MOVE"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B78-79"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding SpeedMove, Mode=TwoWay}"
                                                  Minimum="0" Maximum="5000"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Van toc di chuyen AGV"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,225,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="LIFT MODE (out)"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B80-81"/>
                                    </Border>
                                    <ComboBox Grid.Column="2"
                                              SelectedIndex="{Binding ModeLiftOut, Mode=TwoWay}">
                                        <ComboBoxItem Content="0 - Dung/Reset"/>
                                        <ComboBoxItem Content="1 - Nang"/>
                                        <ComboBoxItem Content="2 - Ha"/>
                                    </ComboBox>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Mode ban nang yeu cau"/>
                                </Grid>
                                <Separator Classes="row"/>
                                <Grid ColumnDefinitions="165,80,130,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Classes="label" Text="SPEED LIFT"/>
                                    <Border Grid.Column="1" Classes="offsetBadge">
                                        <TextBlock Classes="offset" Text="B82-83"/>
                                    </Border>
                                    <NumericUpDown Grid.Column="2"
                                                  Value="{Binding SpeedLift, Mode=TwoWay}"
                                                  Minimum="0" Maximum="5000"/>
                                    <TextBlock Grid.Column="3" Classes="note" Text="Van toc ban nang"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3 - MEMORY MAP -->
            <TabItem Header="  MEMORY MAP  ">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="2,6">
                    <StackPanel Margin="4,0" Spacing="0">

                        <Border Classes="card">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="cardTitle" Text="DB172  INPUT AREA  (BYTE 0-59)"/>
                                <Border Background="#f8f9fb" CornerRadius="4" Padding="12,8"
                                        BorderBrush="#e8eaef" BorderThickness="1">
                                    <StackPanel Spacing="2">
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B0      FLAGS_IN        bit0=ON_OFF  bit1=START  bit2=CLEAR_ERROR  bit3=SAFETY_RELAY"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B2-5    VALUE_VOLTAGE   float32 BE  [V]"/>
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B6-9    VALUE_CURRENT   float32 BE  [A]"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B10-11  SIGNAL_EMGS     int16  bit array"/>
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B12-13  SIGNAL_BUMPER   int16  bit array"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B14-15  STATUS_SENSOR   int16  bit array"/>
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B16-17  SAFETY_ZONE_1   int16  bit array"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B18-19  SAFETY_ZONE_2   int16  bit array"/>
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B20-21  STATUS_RFID     int16  -1/0/1"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B22-23  CODE_RFID       int16"/>
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B24-25  STATUS_MAGLINE  int16  -1/1"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B26-27  VALUE_MAGLINE   int16  bit array"/>
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B28-29  STATUS_MOTOR_1  int16  -1/1"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B30-31  WARN_MOTOR_1    int16"/>
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B32-33  ERROR_MOTOR_1   int16"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B34-35  SPEED_1         int16  [rpm]"/>
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B36-39  VALUE_ENCODER_1 int32  BE"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B40-41  STATUS_MOTOR_2  int16  -1/1"/>
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B42-43  WARN_MOTOR_2    int16"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B44-45  ERROR_MOTOR_2   int16"/>
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B46-47  SPEED_2         int16  [rpm]"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B48-51  VALUE_ENCODER_2 int32  BE"/>
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B52-53  MOVE_MOVE_IN    int16  0-13"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B54-55  STATUS_MOVE     int16"/>
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B56-57  MODE_LIFT_IN    int16  0=stop 1=up 2=down"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B58-59  STATUS_LIFT     int16  0-6"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="cardTitle" Text="DB172  OUTPUT AREA  (BYTE 60-83)"/>
                                <Border Background="#f8f9fb" CornerRadius="4" Padding="12,8"
                                        BorderBrush="#e8eaef" BorderThickness="1">
                                    <StackPanel Spacing="2">
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B60     FLAGS_OUT       bit0=WRITE_EMG  bit1=RESET  bit2=CHARGE  bit3=BRAKE"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B62-63  SOUND           int16  0-10"/>
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B64-65  LIGHT           int16  0-10"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B66-67  FIELD_SET_1     int16  0-10"/>
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B68-69  FIELD_SET_2     int16  0-10"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B70-71  CONTROL_MOTION  int16  1/2"/>
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B72-73  SPEED_MOTOR_1   int16  left wheel"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B74-75  SPEED_MOTOR_2   int16  right wheel"/>
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B76-77  MOVE_MOVE_OUT   int16  0-13"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B78-79  SPEED_MOVE      int16"/>
                                        <TextBlock Foreground="#2c3345" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B80-81  MODE_LIFT_OUT   int16  0/1/2"/>
                                        <TextBlock Foreground="#6b7280" FontFamily="Consolas,Monospace" FontSize="11"
                                                   Text="B82-83  SPEED_LIFT      int16"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="cardTitle" Text="RESERVED"/>
                                <TextBlock Foreground="#b0b8c8" FontFamily="Consolas,Monospace" FontSize="11"
                                           Text="Bytes 84-255  (expansion area, 172 bytes available)"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
